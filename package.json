    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "dompurify": "^3.4.16",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "http-proxy": "^1.18.1",
    "idb": "^8.0.3",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
