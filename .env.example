VITE_API_BASE_URL=/api
# Local development only. Production builds never include the mock adapter.
VITE_AUTH_MOCK=true
# Backend OAuth start URL (default below). Keep it on the same site for Strict cookies.
VITE_GOOGLE_AUTH_URL=/oauth2/authorization/google
# Set backend oauth2.redirect-home to http://localhost:5173/auth/callback for local use.
