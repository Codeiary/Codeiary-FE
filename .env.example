VITE_API_BASE_URL=/api
# Local development uses the Node server's proxy to the local backend.
VITE_GOOGLE_AUTH_URL=/oauth2/authorization/google
# Set backend oauth2.redirect-home to http://localhost:5173/auth/callback for local use.
# Production browser URLs are defined in .env.production.
# API_ORIGIN is a Node runtime variable, not a Vite variable. Export it in the
# shell or pass it to Docker; this file does not load it into the Node server.
# Defaults: development http://localhost:8080, production https://api.codeiary.com.
